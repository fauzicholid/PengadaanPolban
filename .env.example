# Connection string ke PostgreSQL (Neon/Vercel Postgres/lainnya)
DATABASE_URL="postgresql://user:password@localhost:5432/pengadaan_polban?sslmode=require"

# Kunci rahasia untuk menandatangani sesi (JWT). Gunakan string acak >= 32 karakter.
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Nama instansi yang ditampilkan pada antarmuka
NEXT_PUBLIC_APP_NAME="Sistem Informasi Pengadaan Barang/Jasa Polban"

# Opsional: kirim email notifikasi verifikasi penyedia via Resend (https://resend.com).
# Bila dikosongkan, email hanya dicatat ke log dan tidak benar-benar terkirim.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
